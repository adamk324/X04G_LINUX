# Pinned kernel source for the X04G build.
# Sourced by scripts/linux/*.sh and by .github/workflows/kernel-build.yml.
#
# Upstream: Luca Leonardo Scorcia's MT8167 / X04G tree (mainline v7.3 + ~100 board/SoC patches).
# Bump KERNEL_COMMIT deliberately and record the change in CHANGELOG.md.

KERNEL_REPO="https://github.com/lscorcia/linux.git"
KERNEL_BRANCH="x04g-7.3"
KERNEL_COMMIT="2fb2bc1fd01cec9dce5431e88c7a78cc5dc335f5"
KERNEL_BASE_TAG="v7.3"

# Device tree built for the target
KERNEL_DTB="mediatek/mt8167-xiaomi-x04g.dtb"

# Out-of-tree Wi-Fi/BT (CONSYS) driver, not built yet - pinned for Milestone 6
CONSYS_REPO="https://github.com/lscorcia/linux-mt8167-consys.git"
CONSYS_COMMIT="9e75325"

# Device firmware blobs (Wi-Fi, BT patch, PowerVR). NOT redistributed by this repo;
# fetched at rootfs build time only.
FIRMWARE_REPO="https://github.com/lscorcia/firmware-xiaomi-x04g.git"
FIRMWARE_COMMIT="caf5c46"
