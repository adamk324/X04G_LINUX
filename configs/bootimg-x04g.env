# Android boot image parameters for the X04G stock LK, measured from the user's stock
# boot.img (sha256 cadd9bc1…, firmware mico_x04g 1.7.5) with unpack_bootimg on 2026-11-08.
# Nothing device-unique here; used by scripts/linux/mkbootimg-x04g.sh (CI and local).

BOOTIMG_HEADER_VERSION=2
BOOTIMG_PAGESIZE=2048
BOOTIMG_BASE=0x00000000
BOOTIMG_RAMDISK_ADDR=0x55000000
BOOTIMG_TAGS_ADDR=0x54000000
BOOTIMG_DTB_ADDR=0x54000000
BOOTIMG_SECOND_ADDR=0x40f00000
BOOTIMG_OS_VERSION=10.0.0
BOOTIMG_OS_PATCH_LEVEL=2021-06

# Boot mode "zimage64" (default, community-proven on 32-bit MTK firmware):
#   LK boots the image as a 32-bit zImage at the stock address; the zimage64 shim asks ATF
#   (smc 0x82000200, KERNEL_64) to switch to AArch64 and then inflates the real kernel.
ZIMAGE64_KERNEL_ADDR=0x40008000
ZIMAGE64_BOOTOPT=bootopt=64S3,32N2,32N2

# Boot mode "native64" (LK's own 64-bit path). Tried 2026-11-08 (T4/T5/T6): LK accepted the
# image but no kernel activity was ever observed. Kept for reference.
NATIVE64_KERNEL_ADDR=0x40080000
NATIVE64_BOOTOPT=bootopt=64S3,32N2,64N2

# zimage64 source (pinned): lscorcia tested 5668afde on MT8167 (pmaports MR !9830)
ZIMAGE64_REPO=https://gitlab.com/sleirsgoevy/zimage64.git
ZIMAGE64_COMMIT=5668afde5b849fad97cce7d68fb72a5af52565a7
ZIMAGE64_UDT_COMMIT=5c65af2fc6aad2c9789609aa696f6d5178e9c2e8
ZIMAGE64_UZLIB_REPO=https://github.com/pfalcon/uzlib.git
ZIMAGE64_UZLIB_COMMIT=6d60d651a4499a64f2e5b21b4cc08d98cb84b5c1
