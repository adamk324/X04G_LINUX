# X04G kernel config fragment, merged on top of arm64 `defconfig`
# by scripts/linux/build-kernel.sh (scripts/kconfig/merge_config.sh).
#
# Source of truth for the device-specific options: the postmarketOS config
# used by lscorcia for x04g experiments (gist 58c575a5…, 7.3.0-rc5).
# Non-MediaTek platforms are switched off to cut build time and image size.

CONFIG_LOCALVERSION="-x04g"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_NR_CPUS=4
CONFIG_HZ_100=y

# ---- Platform: MediaTek only ------------------------------------------------
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_AXIADO=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_PENSANDO=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# ---- Clocks / SoC infrastructure -------------------------------------------
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_COMMON_CLK_MT8167=y
CONFIG_COMMON_CLK_MT8167_AUDSYS=y
CONFIG_COMMON_CLK_MT8167_IMGSYS=y
CONFIG_COMMON_CLK_MT8167_MFGCFG=y
CONFIG_COMMON_CLK_MT8167_MMSYS=y
CONFIG_COMMON_CLK_MT8167_VDECSYS=y
CONFIG_MTK_TIMER=y
CONFIG_MTK_CPUX_TIMER=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MTK_INFRACFG=y
CONFIG_MTK_SCPSYS=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_SMI=y
CONFIG_MTK_IOMMU=y
CONFIG_MTK_CMDQ=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_DEVAPC=y
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_HW_RANDOM_MTK=y
CONFIG_MTK_UART_APDMA=y
CONFIG_TEE=y
CONFIG_OPTEE=y

# ---- PMIC MT6392 ------------------------------------------------------------
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6392=y
CONFIG_REGULATOR_PWM=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_PINCTRL_MT6397=y

# ---- Pinctrl / GPIO / buses -------------------------------------------------
CONFIG_PINCTRL_MTK=y
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_PINCTRL_MT8516_PARIS=y
CONFIG_EINT_MTK=y
CONFIG_I2C_MT65XX=y
CONFIG_SPI_MT65XX=y
CONFIG_SERIAL_8250_MT6577=y

# ---- CPU frequency / thermal -----------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6577_AUXADC=y

# ---- Storage ----------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_PWRSEQ_EMMC=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y

# ---- Display ----------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_FITIPOWER_JD9161Z=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y
CONFIG_PWM_MTK_DISP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# ---- Input ------------------------------------------------------------------
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_KEYBOARD_MT6779=y
CONFIG_INPUT_UINPUT=y
CONFIG_EM3071X=m

# ---- USB (peripheral: gadget networking / serial) ---------------------------
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# ---- Audio ------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=m
CONFIG_SND_SOC_MEDIATEK=m
CONFIG_SND_SOC_MT8516=m
CONFIG_SND_SOC_MT8167=m
CONFIG_SND_SOC_MT8167S_ES7243=m
CONFIG_SND_SOC_MTK_BTCVSD=m
CONFIG_SND_SOC_ES7243=m
CONFIG_SND_SOC_MT8167_CODEC=m
CONFIG_SND_SOC_MT6392_CODEC=m

# ---- Wireless stack (driver comes from out-of-tree consys module) -----------
CONFIG_CFG80211=y
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m

# ---- Low-RAM friendliness ---------------------------------------------------
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_PSI=y

# ---- Boot -------------------------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CONFIG_CMDLINE=""

# ---- Not present on this board: trimmed from defconfig to speed up builds ----
# MT8167 has no PCIe, SATA, CAN, camera pipeline in use, or hypervisor needs.
CONFIG_PCI=n
CONFIG_ACPI=n
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n
CONFIG_XEN=n
CONFIG_ATA=n
CONFIG_CAN=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_INFINIBAND=n
CONFIG_FPGA=n
CONFIG_STAGING=n
CONFIG_MTD=n
CONFIG_NFC=n
CONFIG_SOUNDWIRE=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_I2C_NXP_TDA998X=n
CONFIG_DRM_ETNAVIV=n
CONFIG_ARM_SMMU=n
CONFIG_ARM_SMMU_V3=n
CONFIG_NET_DSA=n
CONFIG_USB_SERIAL=n
CONFIG_SCSI_UFSHCD=n
CONFIG_IPMI_HANDLER=n
